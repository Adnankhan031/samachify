# Copy to .env and fill in. Only EXPO_PUBLIC_* vars reach the app bundle —
# never put the Supabase service-role key or the Razorpay secret in here.

# Supabase → Project Settings → API (same project as the web storefront)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The Next.js storefront that owns order creation (/api/orders).
# The app never prices or inserts orders itself — the server re-prices the cart.
# Local dev on a physical device needs your LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=https://samachify.in

# Google Maps key for the map-based address picker.
# Restrict it in Google Cloud Console to the app's package name + signing SHA-1.
GOOGLE_MAPS_API_KEY=your-android-maps-key
