{
  "expo": {
    "name": "Samachify",
    "slug": "samachify",
    "version": "1.0.0",
    "owner": "samachify_farm_to_pan",
    "orientation": "portrait",
    "icon": "./assets/images/logo-square.png",
    "scheme": "samachify",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFFF5",
    "android": {
      "package": "in.samachify.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F6FFE9",
        "foregroundImage": "./assets/images/logo-square.png",
        "monochromeImage": "./assets/images/logo-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "in.samachify.app",
      "supportsTablet": true
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFFF5",
          "image": "./assets/images/logo-square.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Samachify uses your location only to fill in a delivery address when you tap Use my current location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fe273a7b-8f35-4a29-850e-329704844db2"
      }
    }
  }
}
