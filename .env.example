# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (online payments). Leave blank to keep online payment hidden (COD still works).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend (order confirmation emails). Leave blank to skip emails entirely.
# ORDER_FROM_EMAIL must be a verified domain/sender in Resend.
RESEND_API_KEY=
ORDER_FROM_EMAIL=Samachify <orders@samachify.in>

# Google Maps delivery pricing. Enable Maps JavaScript API, Geocoding API and
# Routes API for the project. Keep the Routes key server-side.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Medavakkam operating office; override only if the dispatch point changes.
DISPATCH_LATITUDE=12.9219353
DISPATCH_LONGITUDE=80.192949

# Optional comma-separated override. When blank, the ten approved service
# pincodes in src/lib/office.ts are used.
DELIVERY_PINCODES=
