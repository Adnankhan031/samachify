# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only — never expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay (online payments). Leave blank to keep online payment hidden (COD still works).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Resend (order confirmation emails). Leave blank to skip emails entirely.
# ORDER_FROM_EMAIL must be a verified domain/sender in Resend.
RESEND_API_KEY=
ORDER_FROM_EMAIL=Samachify <orders@samachify.in>
